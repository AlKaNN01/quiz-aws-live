# ========================================
# Database Configuration
# ========================================
DB_PASSWORD=postgres123
DB_USER=postgres

# ========================================
# Redis Configuration
# ========================================
REDIS_PASSWORD=redis123
REDIS_PORT=6379

# ========================================
# JWT & Security
# ========================================
# IMPORTANT: Change these in production!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-12345-
ENGINE_TOKEN=your-engine-secret-token-change-this-in-production-12345

# ========================================
# Environment
# ========================================
# development = local testing (more logs, stack traces)
# production = AWS/server (less overhead, security)
ENVIRONMENT=development
LOG_LEVEL=INFO

# ========================================
# Frontend Configuration
# ========================================
# For docker-compose build args
REACT_APP_API_URL=https://yourdomain.com
REACT_APP_WS_URL=wss://yourdomain.com

# ========================================
# CORS & Origins
# ========================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost,https://yourdomain.com

# ========================================
# GameAdmin & GameEngine URLs
# ========================================
GAME_ADMIN_URL=http://game-admin:8080

