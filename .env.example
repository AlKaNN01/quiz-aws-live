# ========================================
# DOMAIN & HTTPS (Production)
# ========================================
# Your domain name (e.g., quiz-game.com, quiz-game.yourdomain.com)
DOMAIN=yourdomain.com

# PostgreSQL Configuration
DB_URL=jdbc:postgresql://postgres:5432/gameadmin
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# JWT & Security
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_minimum_32_chars_here
ENGINE_TOKEN=your_secure_engine_to_admin_service_token_here

# Admin Initialization (required)
ADMIN_PASSWORD=your_secure_admin_password_here
HOST_PASSWORD=your_secure_host_password_here

# CORS & Service URLs
ALLOWED_ORIGINS=https://${DOMAIN}
GAME_ADMIN_URL=http://gameadmin:8081

# Frontend URLs (auto-detected from protocol)
REACT_APP_API_URL=https://${DOMAIN}/api
REACT_APP_WS_URL=wss://${DOMAIN}/ws

# Database Migration Strategy
# DEV: update | PROD: validate (use Liquibase/Flyway for production migrations)
JPA_DDL_AUTO=validate

# Application Logging
LOG_LEVEL=INFO

